# /etc/systemd/system/job-tracker.service
[Unit]
Description=Job Tracker
After=network.target

[Service]
User=jobtracker
Group=jobtracker
WorkingDirectory=/opt/job-tracker
EnvironmentFile=/etc/job-tracker/job-tracker.env
# Listens on localhost only; Caddy is the front door. Proxy headers are ignored
# because nothing in the app needs the browser's IP.
ExecStart=/opt/job-tracker/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8300 --no-proxy-headers --workers 1
Restart=on-failure
RestartSec=3

# Hardening: read-only system, writable data dir only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/job-tracker

[Install]
WantedBy=multi-user.target
