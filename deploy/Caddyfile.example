# Add to your Caddyfile, then: sudo systemctl reload caddy
# Login is Authelia's (deploy/authelia.example.yml); Caddy asks it about every
# browser request with forward_auth. Reads the proxy secret from
# /etc/caddy/jobtracker-proxy-secret (deploy/SETUP.md, step 5).
jobtracker.thezdev.com {
	# Never pass along a secret header a client tried to send itself.
	request_header -X-Proxy-Secret

	# Agents (Claude) send "Authorization: Bearer <token>". They skip Authelia;
	# the app checks the token itself and rejects anything else. (Authelia would
	# also try to read that header as one of its own tokens and refuse it.)
	@agent header Authorization "Bearer *"
	handle @agent {
		reverse_proxy 127.0.0.1:8300
	}

	# Everyone else signs in at Authelia first. Not signed in: Authelia answers
	# with a redirect to its portal (or a 401), and the request stops here.
	# Only requests it approves reach the app, carrying the secret the app requires.
	# This droplet's Authelia listens on 127.0.0.1:9091 under the path prefix
	# /authelia (portal: https://apps.thezdev.com/authelia), so its endpoint is
	# /authelia/api/authz/forward-auth. An Authelia served at its own domain's
	# root would use /api/authz/forward-auth instead.
	handle {
		forward_auth 127.0.0.1:9091 {
			uri /authelia/api/authz/forward-auth
		}
		reverse_proxy 127.0.0.1:8300 {
			header_up X-Proxy-Secret {file./etc/caddy/jobtracker-proxy-secret}
		}
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
	}
}
