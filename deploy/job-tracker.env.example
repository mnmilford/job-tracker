# /etc/job-tracker/job-tracker.env  (chmod 600, owned by root)
DB_PATH=/var/lib/job-tracker/tracker.db
AUTH_MODE=proxy
# Shared with Caddy: it adds this to every request Authelia approved, and
# the app refuses token-less requests without it. 32+ chars. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SECRET=REPLACE_ME_TOO
# Agent tokens, "name:token" comma-separated, 32+ chars each. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=claude:REPLACE_ME
OWNER_NAME=Your Name
# Where resume/cover-letter files live, for the file links on each application.
DOCS_REPO_URL=https://github.com/<you>/<private-docs-repo>
DOCS_BRANCH=main
# Optional: read-only GitHub token so the app can show those files itself (PDF
# viewer, Word downloads) instead of linking to GitHub. Fine-grained token,
# "Only select repositories" = the docs repo, permission Contents: Read-only.
# See deploy/SETUP.md step 9. Leave empty to keep plain GitHub links.
DOCS_GITHUB_TOKEN=
